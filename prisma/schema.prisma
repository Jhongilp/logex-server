// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// npx prisma db push --force-reset -> reset database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  nit                   String                @id
  name                  String
  country               String
  city                  String
  users                 User[]
  customer              Customer[]
  expos                 Expo[]
  expoDefaultActivities DefaultExpoActivity[]
}

model User {
  id              String   @unique @db.Uuid
  email           String   @unique
  first_name      String
  second_name     String?
  first_lastname  String
  second_lastname String?
  role            Int?
  company         Company? @relation(fields: [company_id], references: [nit])
  company_id      String
}

model Customer {
  id          String     @id @default(uuid())
  name        String
  country     String
  city        String
  address     String
  shippings   Shipping[]
  expos       Expo[]
  company     Company?   @relation(fields: [company_nit], references: [nit])
  company_nit String?
}

model Shipping {
  id             String   @id @default(uuid())
  consignee      String
  notify         String
  country        String
  city           String
  transport_mode String
  address        String
  contact        String
  email          String
  phone          String
  obs            String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  expos          Expo[]
}

model Expo {
  consecutivo    String             @id @unique
  status         Int
  globalProgress Int
  createdAt      DateTime           @default(now())
  shippingId     String
  shipping       Shipping           @relation(fields: [shippingId], references: [id])
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  todoList       ExpoTodoActivity[]
  Company        Company            @relation(fields: [company_nit], references: [nit])
  company_nit    String
}

enum ExpoStatus {
  PREVIO_CARGUE
  TRANSITO_PUERTO
  EN_PUERTO
  TRANSITO_INTERNACIONAL
  EN_DESTINO
  FINALIZADO
}

enum ProgressStatus {
  SIN_INICIAR
  EN_CURSO
  EN_ESPERA
  RETRASADO
  COMPLETADO
}

model ExpoTodoActivity {
  id          String         @id @default(uuid())
  name        String
  status      ExpoStatus     @default(PREVIO_CARGUE)
  progress    ProgressStatus @default(SIN_INICIAR)
  responsible String
  optional    Boolean
  enabled     Boolean
  completedAt DateTime?
  deadline    DateTime?
  Expo        Expo?          @relation(fields: [expoId], references: [consecutivo])
  expoId      String
  company_nit String
}

model DefaultExpoActivity {
  id          Int            @id @default(autoincrement())
  name        String
  status      ExpoStatus     @default(PREVIO_CARGUE)
  progress    ProgressStatus @default(SIN_INICIAR)
  responsible String
  optional    Boolean
  enabled     Boolean
  Company     Company?       @relation(fields: [company_nit], references: [nit])
  company_nit String
}
