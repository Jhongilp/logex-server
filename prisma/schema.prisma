// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// npx prisma db push --force-reset -> reset database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  nit                   String                @id
  name                  String
  country               String
  city                  String
  users                 User[]
  customer              Customer[]
  expos                 Expo[]
  expoDefaultActivities DefaultExpoActivity[]
}

model User {
  id              String   @unique @db.Uuid
  email           String   @unique
  first_name      String
  second_name     String?
  first_lastname  String
  second_lastname String?
  role            Int?
  company         Company? @relation(fields: [company_id], references: [nit])
  company_id      String
}

model Customer {
  id          String     @id @default(uuid())
  name        String
  country     String
  city        String
  address     String
  shippings   Shipping[]
  expos       Expo[]
  company     Company?   @relation(fields: [company_nit], references: [nit])
  company_nit String?
}

model Shipping {
  id             String   @id @default(uuid())
  consignee      String
  notify         String
  country        String
  city           String
  transport_mode String
  address        String
  contact        String
  email          String
  phone          String
  obs            String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  expos          Expo[]
}

enum ExpoStatus {
  PREVIO_CARGUE
  TRANSITO_PUERTO
  EN_PUERTO
  TRANSITO_INTERNACIONAL
  EN_DESTINO
  FINALIZADO
}

enum ProgressStatus {
  SIN_INICIAR
  EN_CURSO
  EN_ESPERA
  RETRASADO
  COMPLETADO
}

model Expo {
  consecutivo    String             @id @unique
  status         ExpoStatus         @default(PREVIO_CARGUE)
  globalProgress Int
  createdAt      DateTime           @default(now())
  shippingId     String
  shipping       Shipping           @relation(fields: [shippingId], references: [id])
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  todoList       ExpoTodoActivity[]
  Company        Company            @relation(fields: [company_nit], references: [nit])
  company_nit    String
  booking        Booking?
}

model ExpoTodoActivity {
  id          String         @id @default(uuid())
  name        String
  status      ExpoStatus     @default(PREVIO_CARGUE)
  progress    ProgressStatus @default(SIN_INICIAR)
  responsible String
  optional    Boolean
  enabled     Boolean
  completedAt DateTime?
  deadline    DateTime?
  Expo        Expo?          @relation(fields: [expoId], references: [consecutivo])
  expoId      String
  company_nit String
}

model DefaultExpoActivity {
  id          Int            @id @default(autoincrement())
  name        String
  status      ExpoStatus     @default(PREVIO_CARGUE)
  progress    ProgressStatus @default(SIN_INICIAR)
  responsible String
  optional    Boolean
  enabled     Boolean
  Company     Company?       @relation(fields: [company_nit], references: [nit])
  company_nit String
}

model Booking {
  id                 String      @id @default(uuid())
  consignee          String
  notify             String
  shippingCompany    String
  broker             String
  transportMode      String
  cityBondPort       String
  bondPort           String
  destinationCountry String
  destinationCity    String
  bookingNumber      String
  billOfLandingId    String
  vesselName         String
  voyage             String
  eta                DateTime?
  etd                DateTime?
  etaDestination     DateTime?
  documentsDeadline  DateTime?
  inPortDeadline     DateTime?
  rollover           Boolean?
  expo               Expo        @relation(fields: [expoId], references: [consecutivo])
  expoId             String      @unique
  containers         Container[]
}

enum ContainerType {
  DRY_20
  DRY_40
  DRY_40HC
  REEFER_20
  REEFER_40
  REEFER_40HC
}

model Container {
  id              String        @id @default(uuid())
  containerNumber String
  vehicleId       String
  transportName   String
  bookingId       String
  type            ContainerType
  dateWithdrawal  DateTime?
  dateLoad        DateTime?
  datePortEntry   DateTime?
  dateSail        DateTime?
  netWeight       Int?          @default(0)
  grossWeight     Int?          @default(0)
  createdAt       DateTime      @default(now())
  Booking         Booking       @relation(fields: [bookingId], references: [id])
}
